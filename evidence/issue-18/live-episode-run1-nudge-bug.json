          "parameters": {
            "type": "object",
            "properties": {
              "choice": {
                "type": "string",
                "enum": [
                  "maintain",
                  "expedite",
                  "alternate"
                ],
                "description": "recovery option to commit"
              }
            },
            "required": [
              "choice"
